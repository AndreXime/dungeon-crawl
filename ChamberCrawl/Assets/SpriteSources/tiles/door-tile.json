  "canvasCode": "function draw(ctx, size) {\n  ctx.imageSmoothingEnabled = false;\n  const O = '#0d0a08', P1 = '#2a2620', P2 = '#4a443c', P3 = '#6a6358';\n  const W1 = '#3d2814', W2 = '#8b5a2b', W3 = '#c4a06a';\n  const px = (x, y, w, h, c) => { ctx.fillStyle = c; ctx.fillRect(x|0, y|0, w|0, h|0); };\n  px(0, 0, 32, 32, P1);\n  for (let y = 0; y < 32; y += 4) {\n    for (let x = 0; x < 32; x += 4) {\n      if (((x / 4) + (y / 4)) % 2 === 0) px(x, y, 4, 4, P2);\n    }\n  }\n  px(0, 0, 10, 32, P1);\n  px(22, 0, 10, 32, P1);\n  px(0, 0, 32, 4, P1);\n  px(10, 0, 12, 32, O);\n  px(11, 1, 10, 30, W2);\n  px(11, 1, 10, 1, W3);\n  px(11, 1, 1, 30, W3);\n  px(20, 1, 1, 30, W1);\n  px(11, 14, 10, 2, O);\n  px(12, 15, 8, 1, P1);\n  px(0, 0, 32, 1, O);\n  px(0, 31, 32, 1, O);\n}\n"
